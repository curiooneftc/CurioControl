# EditorConfig — https://editorconfig.org
# Shared conventions for everyone and every IDE working on CurioControl.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so do not strip them.
trim_trailing_whitespace = false

[*.{kts,gradle}]
indent_size = 4

[Makefile]
indent_style = tab

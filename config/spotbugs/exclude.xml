<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions for CurioControl.

  Only intentional, documented patterns belong here. Anything added must state why the
  finding is a false positive or an accepted trade-off. See docs/CI_CD_SETUP.md §5.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/master/spotbugs/etc/findbugsfilter.xsd">

    <!-- Tests: readability and defensive-coding findings are noise in test code.

         ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD is here because CurioConfig's flags are global by
         design, and testing the telemetry cadence means setting them. JUnit gives each test its own
         instance, so there is no shared-state hazard in the test suite itself; the production
         Javadoc on CurioConfig states the single-threaded OpMode-thread contract.
    -->
    <Match>
        <Source name="~.*[\\/]src[\\/]test[\\/].*"/>
        <Or>
            <Bug pattern="DM_DEFAULT_ENCODING"/>
            <Bug pattern="DM_EXIT"/>
            <Bug pattern="DM_GC"/>
            <Bug pattern="DM_STRING_VOID_CTOR"/>
            <Bug pattern="DM_STRING_TOSTRING"/>
            <Bug pattern="MS_EXPOSE_REP"/>
            <Bug pattern="MS_SHOULD_BE_FINAL"/>
            <Bug pattern="NP_NULL_ON_SOME_PATH_FROM_RETURN_VALUE"/>
            <Bug pattern="RCN_REDUNDANT_NULLCHECK_OF_NONNULL_VALUE"/>
            <Bug pattern="SIC_INNER_SHOULD_BE_STATIC"/>
            <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
            <Bug pattern="UWF_FIELD_NOT_INITIALIZED_IN_CONSTRUCTOR"/>
            <Bug pattern="URF_UNREAD_FIELD"/>
        </Or>
    </Match>

    <!-- JMH benchmarks: measurement code, not shipped code.
         PA fires because JMH state fields must be accessible to the generated runner in the
         same package — private state is not an option, so the exposure warning is structural
         noise. ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD fires because benchmarks save and
         restore the global CurioConfig flags they measure under; JMH forks isolate trials and
         teardown restores the values, so there is no cross-benchmark leak.
    -->
    <Match>
        <Source name="~.*[\\/]src[\\/]jmh[\\/].*"/>
        <Or>
            <Bug pattern="PA_PUBLIC_PRIMITIVE_ATTRIBUTE"/>
            <Bug pattern="ST_WRITE_TO_STATIC_FROM_INSTANCE_METHOD"/>
        </Or>
    </Match>

    <!--
      Mockito mocks of FTC SDK types. SDK classes are not designed to be implemented, and
      the tests are exercising the wrapper's own delegation logic (TESTING_STRATEGY.md §3.2).
    -->
    <Match>
        <Source name="~.*[\\/]src[\\/]test[\\/].*"/>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
            <Bug pattern="EQ_OVERRIDING_EQUALS_NOT_SYMMETRIC"/>
            <Bug pattern="SE_BAD_FIELD"/>
            <Bug pattern="SE_NO_SERIALVERSIONID"/>
        </Or>
    </Match>

    <!--
      EI / EI2 on the hardware and telemetry adapters.

      Storing and returning the SDK object is the entire point of these classes. ADR-005 commits to
      the wrapper approach *because* direct SDK access stays possible: getSdkObject() is the
      documented escape hatch, so that any device the framework does not cover is still reachable
      without forking a wrapper. SpotBugs' concern is that the caller can mutate the wrapper's
      internals through the returned reference — which is the intended, documented behaviour, and
      the same reference the SDK itself hands out.

      This is not a real encapsulation violation. Defensively copying a DcMotorEx would be worse:
      writes to the copy would not reach the hardware, which is precisely the bug this framework
      exists to prevent.

      `drive` is here for the same reason and a different reason: a drivetrain legitimately exposes
      its motors (left(), right(), frontLeft(), ...) so a team can read a single wheel's position
      or set one motor's direction without reaching for the SDK. That is a public API decision, not
      an oversight.

       `CurioRobot` is here for the most obvious reason of all: the specification's facade is
       robot.drive() and robot.telemetry(). Returning the live drivetrain and telemetry manager is the
       API. Returning a copy would be a facade that does not drive the robot.

       `command` is here because requirements sets are frozen at construction
       (Collections.unmodifiableSet over a copy) and read on every schedule: returning the set
       is the ownership API, a caller cannot mutate through it, and copying it per read would
       put an allocation on the scheduler's hot path for no safety gain.
    -->
    <Match>
        <Or>
            <Class name="~org\.curioone\.control\.hardware\..*"/>
            <Class name="~org\.curioone\.control\.drive\..*"/>
            <Class name="~org\.curioone\.control\.core\.(SdkTelemetrySink|TelemetryManager|SdkHardwareSource|HardwareRegistry|CurioRobot)"/>
            <Class name="~org\.curioone\.control\.command\..*"/>
            <Class name="~org\.curioone\.control\.vision\..*"/>
        </Or>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>

    <!--
      CurioConfig's public mutable statics are the framework's documented configuration surface
      (CurioConfig.java, class Javadoc). Making them final would defeat their purpose: a team sets
      CurioConfig.DEBUG = true at the top of an OpMode to turn on debug output.

      MS_SHOULD_BE_FINAL is a false positive for a configuration holder by design. Making the
      fields volatile would be worse than useless here: the values are written once during init and
      read thousands of times per match, so there is no cross-thread publication to make safe, and
      a volatile read on a hot path is a real (if small) cost.
    -->
    <Match>
        <Class name="~org\.curioone\.control\.core\.CurioConfig"/>
        <Bug pattern="MS_SHOULD_BE_FINAL"/>
    </Match>

    <!--
      A CLI entry point legitimately discards the result of System.exit when running under
      Gradle's Exec tasks. Nothing in this project ships a main() method yet; this rule is
      here so it does not have to be re-derived later.
    -->
    <Match>
        <Class name="~org\.curioone\.control\.util\.Cli"/>
    </Match>
</FindBugsFilter>
